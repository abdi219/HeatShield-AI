# ==============================================================================
# HeatShield AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local to GitHub!

# --- Client-Side Public Keys ---
# Mapbox public token for vector map rendering and geocoding
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# Supabase public credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Server-Side Protected Keys (Never exposed to client) ---
# FortyGuard API Key & Base Endpoint
FORTYGUARD_API_KEY=your_fortyguard_api_key_here
FORTYGUARD_API_BASE_URL=https://api.fortyguard.com/v1

# Supabase Service Role Key (for administrative backend operations & cache management)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI Provider Configuration (Groq or Google Gemini)
AI_PROVIDER=groq # 'groq' | 'gemini'
AI_API_KEY=your_groq_or_gemini_api_key_here
AI_MODEL=llama-3.1-70b-versatile # or gemini-1.5-flash
